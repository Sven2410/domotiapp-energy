# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tool caches and coverage output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local Home Assistant development instance.
# Note: docker-compose.dev.yml itself IS tracked; only its generated config is not.
.ha-dev-config/

# Credentials for the verification script (scripts/ha_check.py): HA_URL and a
# long-lived access token. Never commit this — the token grants full API access
# to the Home Assistant instance it was created on.
.env
.env.*
!.env.example

# Frontend test tooling. package.json and package-lock.json ARE tracked; the
# installed packages are not. The integration itself ships no JavaScript
# dependencies and has no build step.
node_modules/

# Editors and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Playwright leaves traces, videos and its HTML report behind after a failure.
test-results/
playwright-report/
blob-report/
