# Test image for the DomotiApp Energy test suite.
#
# Home Assistant pins native dependencies that publish no Windows wheel for
# the interpreter it requires, so `pip install -e ".[dev]"` cannot succeed on
# the development machine without MSVC build tools. Running the suite in this
# container avoids that entirely and matches the GitHub Actions workflow.
#
# Python 3.14 since 2026-08-09: Home Assistant 2026.8 requires >= 3.14.2 and the
# test harness follows it. Staying on 3.13 meant testing against 2026.2.3,
# five months behind what a customer runs.
FROM python:3.14-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# A C toolchain is required to build lru-dict from source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only the project metadata is copied here, so the slow dependency install ends
# up in its own image layer that is reused until pyproject.toml changes. The
# source tree itself is bind-mounted over /app at run time.
COPY pyproject.toml ./
COPY scripts/install_frontend_requirement.py ./scripts/
RUN pip install -e ".[dev]" \
    && python scripts/install_frontend_requirement.py

CMD ["pytest"]
