# Test image for the DomotiApp Energy test suite.
#
# Home Assistant pins lru-dict==1.3.0, which publishes no cp313 wheel. On
# Windows that means the test dependencies cannot be installed without MSVC
# build tools. Running the suite in this container avoids that entirely and
# matches what the GitHub Actions workflow does.
FROM python:3.13-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# A C toolchain is required to build lru-dict from source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only the project metadata is copied here, so the slow dependency install ends
# up in its own image layer that is reused until pyproject.toml changes. The
# source tree itself is bind-mounted over /app at run time.
COPY pyproject.toml ./
RUN pip install -e ".[dev]"

CMD ["pytest"]
